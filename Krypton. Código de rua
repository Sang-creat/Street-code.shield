-- ESPERA O CORPO SER CRIADO E FORÇA O CONTROLE
task.spawn(function()
    task.wait(4) -- Tempo para o Krypton montar o Tetris
    local player = game.Players.LocalPlayer
    local character = player.Character
    if character and character:FindFirstChild("Humanoid") then
        character.Humanoid.Health = 0
        -- Se o jogo permitir, removemos o Humanoide original
        pcall(function() character.Humanoid:Destroy() end)
    end
end)
