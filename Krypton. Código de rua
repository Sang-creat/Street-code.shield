-- 1. EXECUÇÃO DO KRYPTON
loadstring(game:HttpGet("https://raw.githubusercontent.com/KadeTheExploiter/Krypton/main/Module.luau"))()

-- 2. ROTINA DE CONTROLE E ARMAS
task.spawn(function()
    task.wait(4)
    local player = game.Players.LocalPlayer
    local character = player.Character

    -- Forçar transferência
    if character and character:FindFirstChild("Humanoid") then
        character.Humanoid.Health = 0
        pcall(function() character.Humanoid:Destroy() end)
    end

    -- Monitorar Armas
    player.Backpack.ChildAdded:Connect(function(tool)
        if tool:IsA("Tool") then
            tool.Equipped:Connect(function()
                task.wait(0.1)
                local tetris = workspace:FindFirstChild("Tetris")
                if tetris and tetris:FindFirstChild("Right Arm") then
                    tool.Parent = tetris
                end
            end)
        end
    end)
end)
